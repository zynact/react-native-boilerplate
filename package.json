{
  "name": "boilerplate-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "setup:project": "node scripts/setup.js",
    "setup:fastlane": "node scripts/setup-fastlane.js",
    "generate": "node scripts/generate.js",
    "add:socketio": "node scripts/add-module.js socketio",
    "add:websocket": "node scripts/add-module.js websocket",
    "add:sse": "node scripts/add-module.js sse",
    "add:stripe": "node scripts/add-module.js stripe",
    "add:sentry": "node scripts/add-module.js sentry",
    "add:maps": "node scripts/add-module.js maps",
    "add:camera": "node scripts/add-module.js camera",
    "add:i18n": "node scripts/add-module.js i18n",
    "add:push-notifications": "node scripts/add-module.js push-notifications",
    "generate:assets": "node scripts/generate-assets.js"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@hookform/resolvers": "5.5.7",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "@reduxjs/toolkit": "2.12.0",
    "iconsax-react-nativejs": "0.0.8",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-hook-form": "7.83.0",
    "react-native": "0.86.0",
    "react-native-config": "1.6.1",
    "react-native-gesture-handler": "3.1.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.11.3",
    "react-redux": "9.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "8.0.1",
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.1",
    "@react-native/codegen": "0.86.2",
    "@react-native/eslint-config": "0.86.1",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.17",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.5.14",
    "react-native-css-interop": "0.2.6",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "pnpm@11.15.1",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}
